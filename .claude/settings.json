{
  "enableAllProjectMcpServers": true,
  "permissions": {
    "allow": [
      "mcp__Roblox_Studio",
      "Bash(mise run *)",
      "PowerShell(mise run *)",
      "Bash(git *)",
      "PowerShell(git *)",
      "Bash(gh pr *)",
      "PowerShell(gh pr *)"
    ],
    "deny": [
      "mcp__Roblox_Studio__multi_edit",
      "Bash(git push --force*)",
      "PowerShell(git push --force*)",
      "Bash(git push -f*)",
      "PowerShell(git push -f*)",
      "Bash(git reset --hard*)",
      "PowerShell(git reset --hard*)",
      "Bash(git clean*)",
      "PowerShell(git clean*)"
    ]
  }
}
